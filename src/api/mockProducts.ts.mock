// Функции API
export const fetchProducts = async (filters?: {
  category?: string;
  search?: string;
  active?: boolean;
}): Promise<{ data: Product[] }> => {
  await new Promise(resolve => setTimeout(resolve, 500));
  
  let filteredProducts = [...mockProducts];
  
  if (filters?.category) {
    filteredProducts = filteredProducts.filter(p => p.category === filters.category);
  }
  
  if (filters?.search) {
    const searchLower = filters.search.toLowerCase();
    filteredProducts = filteredProducts.filter(p => 
      p.name.toLowerCase().includes(searchLower) || 
      p.sku.toLowerCase().includes(searchLower) ||
      p.barcode.toLowerCase().includes(searchLower)
    );
  }
  
  if (filters?.active !== undefined) {
    filteredProducts = filteredProducts.filter(p => p.is_active === filters.active);
  }
  
  return { data: filteredProducts };
};

export const fetchProductById = async (id: number): Promise<{ data: Product | null }> => {
  await new Promise(resolve => setTimeout(resolve, 300));
  const product = mockProducts.find(p => p.id === id) || null;
  return { data: product };
};

export const fetchProductCosts = async (productId: number): Promise<{ data: ProductCost[] }> => {
  await new Promise(resolve => setTimeout(resolve, 300));
  const costs = mockProductCosts.filter(c => c.product_id === productId);
  return { data: costs };
};

export const fetchCurrentCost = async (productId: number): Promise<{ data: CurrentCost | null }> => {
  await new Promise(resolve => setTimeout(resolve, 200));
  const cost = mockCurrentCosts.find(c => c.product_id === productId) || null;
  return { data: cost };
};

// Функция для получения расширенных данных товара (с метриками и себестоимостью)
export const fetchProductWithMetrics = async (productId: number): Promise<{ data: ProductWithMetrics | null }> => {
  await new Promise(resolve => setTimeout(resolve, 600));
  
  const product = mockProducts.find(p => p.id === productId);
  if (!product) return { data: null };
  
  const currentCost = mockCurrentCosts.find(c => c.product_id === productId);
  const metrics = mockSalesMetrics[productId as keyof typeof mockSalesMetrics];
  
  const productWithMetrics: ProductWithMetrics = {
    ...product,
    current_cost: currentCost ? parseFloat(currentCost.cost) : undefined,
    last_month_sales: metrics?.sales,
    last_month_revenue: metrics?.revenue,
    stock: metrics?.stock,
    profitability: metrics && currentCost 
      ? ((metrics.currentPrice - parseFloat(currentCost.cost)) / metrics.currentPrice * 100)
      : undefined
  };
  
  return { data: productWithMetrics };
};

export const updateProduct = async (id: number, updates: Partial<Product>): Promise<{ data: Product }> => {
  await new Promise(resolve => setTimeout(resolve, 400));
  const index = mockProducts.findIndex(p => p.id === id);
  
  if (index === -1) {
    throw new Error('Товар не найден');
  }
  
  mockProducts[index] = { 
    ...mockProducts[index], 
    ...updates,
    updated_at: new Date().toISOString()
  };
  
  return { data: mockProducts[index] };
};

export const createProduct = async (productData: Omit<Product, 'id' | 'created_at' | 'updated_at' | 'tenant_id'>): Promise<{ data: Product }> => {
  await new Promise(resolve => setTimeout(resolve, 500));
  
  const newProduct: Product = {
    ...productData,
    id: Math.max(...mockProducts.map(p => p.id)) + 1,
    tenant_id: 1, // В моках используем tenant_id = 1
    created_at: new Date().toISOString(),
    updated_at: new Date().toISOString()
  };
  
  mockProducts.push(newProduct);
  return { data: newProduct };
};

// Функция для создания себестоимости
export const createProductCost = async (data: CreateProductCostRequest): Promise<{ data: CreateProductCostResponse }> => {
    await new Promise(resolve => setTimeout(resolve, 400));
    
    const newCost: ProductCost = {
      id: Math.max(...mockProductCosts.map(c => c.id)) + 1,
      product_id: data.product_id,
      cost: data.cost.toString(),
      start_date: data.start_date,
      end_date: data.end_date,
      created_by: data.created_by,
      created_at: new Date().toISOString()
    };
    
    mockProductCosts.push(newCost);
    
    // Обновляем текущую себестоимость
    const existingCurrentCostIndex = mockCurrentCosts.findIndex(c => c.product_id === data.product_id);
    if (existingCurrentCostIndex !== -1) {
      mockCurrentCosts[existingCurrentCostIndex] = {
        ...mockCurrentCosts[existingCurrentCostIndex],
        cost: data.cost.toString(),
        start_date: data.start_date,
        end_date: data.end_date,
        updated_at: new Date().toISOString()
      };
    } else {
      mockCurrentCosts.push({
        id: newCost.id,
        product_id: data.product_id,
        cost: data.cost.toString(),
        start_date: data.start_date,
        end_date: data.end_date,
        created_by: data.created_by,
        created_at: new Date().toISOString()
      });
    }
    
    return { data: newCost };
  };
  
  // Функция для обновления себестоимости
  export const updateProductCost = async (id: number, data: Partial<CreateProductCostRequest>): Promise<{ data: ProductCost }> => {
    await new Promise(resolve => setTimeout(resolve, 400));
    
    const index = mockProductCosts.findIndex(c => c.id === id);
    if (index === -1) {
      throw new Error('Себестоимость не найдена');
    }
    
    mockProductCosts[index] = {
      ...mockProductCosts[index],
      ...data,
      cost: data.cost ? data.cost.toString() : mockProductCosts[index].cost,
      updated_at: new Date().toISOString()
    };
    
    return { data: mockProductCosts[index] };
  };
  
  // Функция для удаления себестоимости
  export const deleteProductCost = async (id: number): Promise<{ success: boolean }> => {
    await new Promise(resolve => setTimeout(resolve, 300));
    
    const index = mockProductCosts.findIndex(c => c.id === id);
    if (index === -1) {
      throw new Error('Себестоимость не найдена');
    }
    
    mockProductCosts.splice(index, 1);
    return { success: true };
  };