// Моковые данные для тестирования без бэкенда
export const mockAuth = {
    login: async (email: string, password: string) => {
      // Имитация задержки сети
      await new Promise(resolve => setTimeout(resolve, 800));
      
      // Простая проверка - любой email и пароль длиной >= 6
      if (password.length >= 6) {
        return {
          data: {
            access_token: 'mock-jwt-token-' + Date.now(),
            user: {
              id: 'user-123',
              email: email,
              name: email.split('@')[0] || 'Пользователь',
              wb_api_key: null,
            },
          },
        };
      } else {
        throw new Error('Неверный email или пароль');
      }
    },
  
    register: async (email: string, password: string, name?: string) => {
      await new Promise(resolve => setTimeout(resolve, 800));
      
      if (password.length >= 6) {
        return {
          data: {
            access_token: 'mock-jwt-token-' + Date.now(),
            user: {
              id: 'user-' + Date.now(),
              email: email,
              name: name || email.split('@')[0] || 'Пользователь',
              wb_api_key: null,
            },
          },
        };
      } else {
        throw new Error('Пароль должен быть не менее 6 символов');
      }
    },
  
    setWbApiKey: async (userId: string, wbApiKey: string) => {
      await new Promise(resolve => setTimeout(resolve, 500));
      return { data: { success: true } };
    },
  };